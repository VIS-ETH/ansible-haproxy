# Managed by ansible (role: haproxy)
# DO NOT EDIT!

global
	log /dev/log	local0 notice
	log /dev/log	local1 notice
{% if haproxy_chroot %}
	chroot /var/lib/haproxy
{% endif %}
	stats socket {{ haproxy_admin_socket }} mode 660 level admin
	stats timeout 30s
	user haproxy
	group haproxy
	daemon

	# Default SSL material locations
	ca-base /etc/ssl/certs
	crt-base /etc/ssl/private

	maxconn {{ haproxy_maxconn }}
	tune.h2.initial-window-size 1048576

	# Default ciphers to use on SSL-enabled listening sockets.
	# For more information, see ciphers(1SSL). This list is from:
	#  https://hynek.me/articles/hardening-your-web-servers-ssl-ciphers/
	ssl-default-bind-ciphers {{ haproxy_ssl_bind_ciphers }}
	ssl-default-bind-options {{ haproxy_ssl_bind_options }}
	ssl-default-server-ciphers {{ haproxy_ssl_bind_ciphers }}
	ssl-default-server-options {{ haproxy_ssl_bind_options }}
	hard-stop-after 90s

{% if haproxy_ssl_dhparams_pem is defined %}
	tune.ssl.default-dh-param 2048
	ssl-dh-param-file {{ haproxy_ssl_dhparams_pem }}
{% endif %}

defaults
	log	global
	mode	http
	option	httplog
	option	dontlognull
	timeout connect 4s
	timeout client  60s
	timeout server  60s
	timeout queue   60s
	timeout http-request 5s
	timeout http-keep-alive 2s
	timeout tunnel 2m
	timeout client-fin 1s
	timeout server-fin 1s
	#option httpclose			# uncomment if we can't keep up with keep alive
	#option nolinger			# uncomment if we run into problems similar to a nkiller2 attack
	option abortonclose			# don't server aborted requests
	option forwardfor			# sets client's IP in X-Forwarded-For
	retries 2
	errorfile 400 /etc/haproxy/errors/400.http
	errorfile 403 /etc/haproxy/errors/403.http
	errorfile 408 /etc/haproxy/errors/408.http
	errorfile 500 /etc/haproxy/errors/500.http
	errorfile 502 /etc/haproxy/errors/502.http
	errorfile 503 /etc/haproxy/errors/503.http
	errorfile 504 /etc/haproxy/errors/504.http

listen stats
	bind 127.0.0.1:10001
	mode http
	stats enable
	stats realm Haproxy\ Statistics
	stats uri /stats
	stats auth foo:bar
